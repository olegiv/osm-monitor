# Copy to .env and replace placeholders with local-only values.
# Keep this file shell-compatible so it can be sourced by Make targets or
# loaded via --env-file. Never commit .env — it contains credentials.

# Webex incoming webhook URL (required unless --dry-run).
# How to create one: README.md -> "Creating the Webex incoming webhook".
OSMMON_WEBEX_WEBHOOK_URL="https://webexapis.com/v1/webhooks/incoming/replace-me"

# OpenRouteService API key, sent as the Authorization header.
# OSMMON_ORS_API_KEY wins when both are set; ORS_API_KEY is accepted as a
# fallback so an existing key entry keeps working unchanged.
ORS_API_KEY="replace-me"

# Service check URLs. Set a URL to "" to disable that check.
OSMMON_OSM_URL="https://api.openstreetmap.org/api/0.6/capabilities.json"
OSMMON_NOMINATIM_URL="https://nominatim.openstreetmap.org/status?format=json"
OSMMON_ORS_URL="https://api.openrouteservice.org/v2/directions/driving-car?start=8.681495,49.41461&end=8.687872,49.420318"

# State file persisted between cron runs (use an absolute path in cron).
OSMMON_STATE_FILE="./osm-monitor-state.json"

# Check behavior.
OSMMON_TIMEOUT="10s"
OSMMON_ATTEMPTS="3"
OSMMON_BACKOFF="5s"

# Identifying User-Agent required by the OSM/Nominatim usage policy.
OSMMON_USER_AGENT="iru-osm-monitor/dev (+oleg.a.ivanchenko@gmail.com)"

# Debug logging: 1 to enable.
#OSMMON_VERBOSE="1"
